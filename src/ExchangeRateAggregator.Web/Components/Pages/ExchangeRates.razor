@page "/exchange-rates"
@rendermode InteractiveServer
@using System.Globalization
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Exchange rates</PageTitle>

<h1>Exchange rates</h1>

<form class="row g-3 align-items-end"
      @onsubmit="LoadRatesAsync"
      @onsubmit:preventDefault>
    <div class="col-sm">
        <label for="base-currency" class="form-label">Base currency</label>
        <input id="base-currency" class="form-control" @bind="baseCurrency"
               required maxlength="3" pattern="[A-Za-z]{3}" />
    </div>

    <div class="col-sm">
        <label for="requested-date" class="form-label">Date</label>
        <input id="requested-date" class="form-control" type="date"
               @bind="requestedDate" required />
    </div>

    <div class="col-sm">
        <label for="target-currency" class="form-label">Target currency</label>
        <input id="target-currency" class="form-control" @bind="targetCurrency"
               placeholder="All targets" />
    </div>

    <div class="col-sm">
        <label for="sort-direction" class="form-label">Sort direction</label>
        <select id="sort-direction" class="form-select" @bind="sortDirection">
            <option value="">API default</option>
            <option value="asc">Ascending</option>
            <option value="desc">Descending</option>
        </select>
    </div>

    <div class="col-sm-auto">
        <button type="submit" class="btn btn-primary" disabled="@isLoading">
            @(isLoading ? "Loading…" : "Get rates")
        </button>
    </div>
</form>

@if (errors.Length > 0)
{
    <div class="alert alert-danger mt-3" role="alert">
        <ul class="mb-0">
            @foreach (var error in errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@if (result is { FailedProviders.Length: > 0 } responseWithFailures)
{
    <p class="alert alert-warning mt-3" role="status">
        Failed providers: @string.Join(", ", responseWithFailures.FailedProviders)
    </p>
}

@if (result is { AllProvidersFailed: false } rates)
{
    <section class="mt-4" aria-labelledby="rates-results-heading">
        <h2 id="rates-results-heading" class="h4">Rates by provider</h2>
        <p>
            Base currency <strong>@rates.BaseCurrency</strong> ·
            Requested date @rates.RequestedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
        </p>

        @if (rates.Providers.Length == 0)
        {
            <p>No rates matched the request.</p>
        }

        @for (var index = 0; index < rates.Providers.Length; index++)
        {
            var provider = rates.Providers[index];

            <details class="card mb-3" open="@(index == 0)">
                <summary class="card-header" style="cursor: pointer;">
                    <strong>@provider.ProviderName</strong>
                    <span class="badge bg-secondary ms-2">
                        @provider.Rates.Length @(provider.Rates.Length == 1 ? "rate" : "rates")
                    </span>
                </summary>

                @if (provider.Rates.Length == 0)
                {
                    <p class="card-body mb-0">
                        No rates matched the request for this provider.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped mb-0"
                               aria-label="@($"{provider.ProviderName} exchange rates")">
                            <thead>
                                <tr>
                                    <th scope="col">Target currency</th>
                                    <th scope="col" class="text-end">
                                        Rate per unit of @rates.BaseCurrency
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rate in provider.Rates)
                                {
                                    <tr>
                                        <th scope="row">@rate.TargetCurrency</th>
                                        <td class="text-end">@FormatRate(rate.Rate)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </details>
        }
    </section>
}

@code {
    private string baseCurrency = "EUR";
    private DateOnly? requestedDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private string targetCurrency = "";
    private string sortDirection = "";

    private ExchangeRatesResponse? result;
    private string[] errors = [];
    private bool isLoading;

    private async Task LoadRatesAsync()
    {
        if (isLoading || requestedDate is not { } date)
        {
            return;
        }

        isLoading = true;
        result = null;
        errors = [];

        try
        {
            using var client = HttpClientFactory.CreateClient("ExchangeRateApi");
            using var response = await client.GetAsync(BuildRequestUrl(date));

            await ApplyResponseAsync(response);
        }
        catch (HttpRequestException)
        {
            errors = ["Could not reach the exchange-rate API."];
        }
        catch (OperationCanceledException)
        {
            errors = ["The rates request timed out."];
        }
        catch (JsonException)
        {
            errors = ["The API returned an invalid rates response."];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyResponseAsync(HttpResponseMessage response)
    {
        if (response.StatusCode == HttpStatusCode.BadRequest)
        {
            errors = await ReadValidationErrorsAsync(response.Content);
            return;
        }

        var serviceUnavailable = response.StatusCode == HttpStatusCode.ServiceUnavailable;
        var httpError = $"Rates request failed (HTTP {(int)response.StatusCode}).";

        if (!response.IsSuccessStatusCode && !serviceUnavailable)
        {
            errors = [httpError];
            return;
        }

        ExchangeRatesResponse? payload;

        try
        {
            payload = await response.Content.ReadFromJsonAsync<ExchangeRatesResponse>();
        }
        catch (JsonException) when (serviceUnavailable)
        {
            errors = [httpError];
            return;
        }

        if (payload is null ||
            !HasExpectedShape(payload) ||
            payload.AllProvidersFailed != serviceUnavailable)
        {
            errors = [serviceUnavailable
                ? httpError
                : "The API returned an invalid rates response."];

            return;
        }

        result = payload;

        if (payload.AllProvidersFailed)
        {
            errors = ["All exchange-rate providers failed."];
        }
    }

    private static bool HasExpectedShape(ExchangeRatesResponse payload)
    {
        return !string.IsNullOrWhiteSpace(payload.BaseCurrency) &&
            payload.RequestedDate != default &&
            payload.FailedProviders is not null &&
            payload.Providers is not null &&
            payload.Providers.All(provider =>
                provider is not null &&
                provider.Rates is not null &&
                provider.Rates.All(rate => rate is not null));
    }

    private string BuildRequestUrl(DateOnly date)
    {
        var parameters = new Dictionary<string, string?>
        {
            ["baseCurrency"] = baseCurrency.Trim().ToUpperInvariant(),
            ["date"] = date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            ["targetCurrency"] = string.IsNullOrWhiteSpace(targetCurrency)
                ? null
                : targetCurrency.Trim().ToUpperInvariant(),
            ["sortDirection"] = string.IsNullOrEmpty(sortDirection) ? null : sortDirection
        };

        return QueryHelpers.AddQueryString("api/exchange-rates", parameters);
    }

    private static async Task<string[]> ReadValidationErrorsAsync(HttpContent content)
    {
        var problem = await content.ReadFromJsonAsync<ValidationResponse>();
        var messages = problem?.Errors?.Values.SelectMany(messages => messages).ToArray();

        return messages is { Length: > 0 }
            ? messages
            : ["The API rejected the request."];
    }

    private static string FormatRate(decimal rate)
    {
        var format = rate != 0m && Math.Abs(rate) < 0.0001m
            ? "0.0000########################"
            : "F4";

        return rate.ToString(format, CultureInfo.InvariantCulture);
    }

    private record ExchangeRatesResponse(
        string BaseCurrency,
        DateOnly RequestedDate,
        ProviderRates[] Providers,
        string[] FailedProviders,
        bool AllProvidersFailed);

    private record ProviderRates(string ProviderName, RateEntry[] Rates);

    private record RateEntry(string TargetCurrency, decimal Rate);

    private record ValidationResponse(Dictionary<string, string[]>? Errors);
}